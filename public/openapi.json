{
  "openapi": "3.0.3",
  "info": {
    "title": "Fieldcast",
    "description": "Extract structured data from a document. Send raw text or a PDF plus the list of field names you want, and receive those fields back as typed JSON. Fields that do not appear in the document are returned as null rather than invented. Useful for invoices, receipts, contracts, forms and reports.",
    "version": "unversioned"
  },
  "servers": [
    {
      "url": "https://fieldcast-peach.vercel.app"
    }
  ],
  "paths": {
    "/x402/extract": {
      "post": {
        "operationId": "x402Extract",
        "summary": "Extract fields from a document. Pay per call.",
        "description": "Unpaid calls return HTTP 402. Payment terms are the same object as accepts[0] on that response: scheme exact, network eip155:8453, amount 10000 (0.01 USDC), asset 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913, payTo 0x3f425d6ffd2855585483d65da684651e330759e0. A paid call returns the extraction.",
        "x-x402": {
          "accepts": [
            {
              "scheme": "exact",
              "network": "eip155:8453",
              "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "amount": "10000",
              "payTo": "0x3f425d6ffd2855585483d65da684651e330759e0",
              "maxTimeoutSeconds": 300,
              "extra": {
                "name": "USD Coin",
                "version": "2"
              }
            }
          ]
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file", "fields"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "PDF. The server reads the part named file. A filename ending in .pdf is parsed as a PDF."
                  },
                  "fields": {
                    "type": "string",
                    "description": "Comma-separated field names, at most 40. The server reads this string from the form part named fields. Example: invoice_number,date,subtotal,total"
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fields"],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Raw document text. Omit if uploading a PDF as multipart."
                  },
                  "fields": {
                    "type": "array",
                    "items": { "type": "string" },
                    "maxItems": 40,
                    "description": "Names of the fields to extract."
                  }
                }
              },
              "example": {
                "text": "INVOICE #2026-114\nDate: 14 August 2026\nSubtotal: 1200.00\nTotal: 1416.00",
                "fields": ["invoice_number", "date", "subtotal", "total"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extraction result. Missing fields are null.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvoiceExtraction" },
                "example": {
                  "data": {
                    "invoice_number": "2026-114",
                    "date": "2026-08-14",
                    "subtotal": 1200.0,
                    "total": 1416.0
                  },
                  "chars_processed": 78
                }
              }
            }
          },
          "402": {
            "description": "Payment required. Terms are in the PAYMENT-REQUIRED header. accepts[0] is the object below.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentRequired" }
              }
            }
          },
          "400": {
            "description": "no_document_text, no_fields_requested, too_many_fields, or file_unreadable."
          },
          "502": {
            "description": "extraction_failed."
          },
          "503": {
            "description": "x402_not_configured, or cdp_api_key_required when the mainnet CDP key is missing."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InvoiceExtraction": {
        "type": "object",
        "required": ["data", "chars_processed"],
        "properties": {
          "data": {
            "type": "object",
            "description": "One key per requested field. A field that is not in the document is null. Dates are ISO-8601. Monetary values are numbers.",
            "properties": {
              "invoice_number": { "type": ["string", "null"] },
              "date": {
                "type": ["string", "null"],
                "description": "ISO-8601 date (YYYY-MM-DD)."
              },
              "subtotal": { "type": ["number", "null"] },
              "total": { "type": ["number", "null"] }
            },
            "additionalProperties": true
          },
          "chars_processed": { "type": "integer" }
        },
        "example": {
          "data": {
            "invoice_number": "2026-114",
            "date": "2026-08-14",
            "subtotal": 1200.0,
            "total": 1416.0
          },
          "chars_processed": 78
        }
      },
      "X402Accept": {
        "type": "object",
        "description": "Same payTo, network, and amount as the unpaid response accepts[0]. amount 10000 is 0.01 USDC (6 decimals).",
        "required": ["scheme", "network", "asset", "amount", "payTo", "maxTimeoutSeconds", "extra"],
        "properties": {
          "scheme": { "type": "string", "enum": ["exact"] },
          "network": { "type": "string", "enum": ["eip155:8453"] },
          "asset": { "type": "string", "enum": ["0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"] },
          "amount": { "type": "string", "enum": ["10000"] },
          "payTo": { "type": "string", "enum": ["0x3f425d6ffd2855585483d65da684651e330759e0"] },
          "maxTimeoutSeconds": { "type": "integer", "enum": [300] },
          "extra": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "enum": ["USD Coin"] },
              "version": { "type": "string", "enum": ["2"] }
            }
          }
        }
      },
      "PaymentRequired": {
        "type": "object",
        "required": ["x402Version", "accepts"],
        "properties": {
          "x402Version": { "type": "integer", "enum": [2] },
          "error": { "type": "string" },
          "accepts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/X402Accept" }
          }
        }
      }
    }
  }
}
